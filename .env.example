# ──────────────────────────────────────────────────────────────────────────────
# Salon Central — environment variables
# Copy to .env.local and fill in. Never commit real values.
# ──────────────────────────────────────────────────────────────────────────────

# Public origin, used to build QR-code target URLs and email links.
# Must be the URL customers actually reach — a printed QR code can't be edited.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (Turso / libSQL) ────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# ─── Sessions ─────────────────────────────────────────────────────────────────
# Required in production — middleware fails closed without it.
SESSION_SECRET=

# ─── Data encryption at rest ─────────────────────────────────────────────────
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts all salon data
# and backups in the database (lib/data-crypto.ts). Unset = stored unencrypted.
# NEVER change or lose it once set — data encrypted with it can't be read
# without it. Keep a copy outside Vercel (password manager).
DATA_ENCRYPTION_KEY=

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate a key pair with:
#     npx web-push generate-vapid-keys
# The public key is served to browsers via GET /api/push/public-key and is not
# secret. The private key signs every push and must stay server-side only —
# never prefix it with NEXT_PUBLIC_.
#
# Rotating these invalidates every stored subscription: browsers will refuse
# pushes signed with a different key than the one they subscribed with, and
# customers have to opt in again. Set them once, before going live.
VAPID_PUBLIC_KEY=BPlaceholderPublicKeyReplaceWithGeneratedValue

VAPID_PRIVATE_KEY=PlaceholderPrivateKeyReplaceWithGeneratedValue
# Contact address push services use to reach you about a misbehaving sender.
# Accepts a bare email, a mailto: URI, or an https:// URL.
VAPID_MAILTO=mailto:support@saloncentral.xyz

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
META_WHATSAPP_TOKEN=
WASENDER_API_KEY=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Google Wallet (loyalty passes) ───────────────────────────────────────────
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=

# ─── Misc ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
CRON_SECRET=
ADMIN_ACCESS_CODE=
